### 6. SQLite Database Setup (`src/db/database.js`)

```javascript
const sqlite3 = require('sqlite3').verbose();
const path = require('path');

const dbPath = process.env.DB_PATH || path.join(__dirname, '../../clarity_ai.sqlite');
const db = new sqlite3.Database(dbPath, (err) => {
  if (err) console.error('Failed to open database:', err.message);
  else console.log('📁 SQLite Database initialized:', dbPath);
});

db.serialize(() => {
  // Audio Analytics table
  db.run(`
    CREATE TABLE IF NOT EXISTS audio_analytics (
      id TEXT PRIMARY KEY,
      session_id TEXT,
      transcript TEXT,
      wpm INTEGER,
      clarity_score REAL,
      pitch_stability REAL,
      energy_level REAL,
      filler_words_count INTEGER,
      sentiment TEXT,
      created_at DATETIME DEFAULT CURRENT_TIMESTAMP
    )
  `);

  // Sessions table
  db.run(`
    CREATE TABLE IF NOT EXISTS sessions (
      id TEXT PRIMARY KEY,
      user_id TEXT,
      title TEXT,
      started_at DATETIME,
      ended_at DATETIME,
      duration_seconds INTEGER,
      clarity_score REAL,
      avg_wpm REAL,
      status TEXT
    )
  `);
});

module.exports = db;
```

