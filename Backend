### ⚛️ Frontend React Socket.io Hook Integration

Here is how your React Clay Voice Orb component connects to this backend via Socket.io:

```tsx
import { useEffect, useState } from 'react';
import { io, Socket } from 'socket.io-client';

const SOCKET_SERVER_URL = 'http://localhost:5000';

export function useClayVoiceOrb() {
  const [socket, setSocket] = useState<Socket | null>(null);
  const [orbState, setOrbState] = useState<'IDLE' | 'LISTENING' | 'PROCESSING' | 'SPEAKING'>('IDLE');
  const [amplitudes, setAmplitudes] = useState<number[]>(new Array(16).fill(0.2));
  const [aiResponse, setAiResponse] = useState<string>('');

  useEffect(() => {
    const s = io(SOCKET_SERVER_URL);
    setSocket(s);

    s.on('orb:state', (data) => {
      if (data.state) setOrbState(data.state);
    });

    s.on('orb:visualizer_stream', (data) => {
      if (data.amplitudes) setAmplitudes(data.amplitudes);
    });

    s.on('orb:speech_response', (data) => {
      setOrbState(data.state);
      setAiResponse(data.aiResponse);
    });

    return () => { s.disconnect(); };
  }, []);

  const toggleMic = () => {
    if (!socket) return;
    const nextState = orbState === 'IDLE' ? 'LISTENING' : 'IDLE';
    setOrbState(nextState);
    socket.emit('orb:set_state', { state: nextState });

    if (nextState === 'LISTENING') {
      // Simulate audio payload send
      setTimeout(() => {
        socket.emit('orb:voice_stream', { transcript: "Hello Clarity AI, test session initialized." });
      }, 2500);
    }
  };

  return { orbState, amplitudes, aiResponse, toggleMic };
}
```
